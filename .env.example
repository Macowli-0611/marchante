# ============================================================================
# MARCHANTE — Variables de Entorno (.env.example)
# ============================================================================

# Base de datos PostgreSQL:
# - Desarrollo local sin configuración extra (PostgreSQL embebido PGlite con RLS real):
DATABASE_URL="pglite://.data/marchante-pg"
# - Producción (Supabase / Railway / Neon / Docker Postgres):
# DATABASE_URL="postgresql://USUARIO:CLAVE@HOST:5432/postgres"
# Las migraciones (drizzle/NNNN_*.sql) se aplican solas al arrancar o con `pnpm db:migrate`.

# Secreto para firmar las sesiones (OBLIGATORIO en producción, mínimo 32 caracteres).
# Genera uno con: openssl rand -hex 32
# En producción la app NO arranca con un valor vacío, corto o de ejemplo.
AUTH_SECRET="cambia-esto-por-un-secreto-de-32-caracteres-o-mas"

# URL pública base de la aplicación (enlaces del catálogo y QR)
NEXT_PUBLIC_APP_URL="http://localhost:3100"

# Tienda de demostración "Horno & Canela".
# Activa por defecto en desarrollo; APAGADA en producción salvo ENABLE_DEMO="true".
# ENABLE_DEMO="false"

# Proxies de confianza delante de la app (para leer la IP real en los límites de intentos).
# 1 = un solo proxy (Vercel, Nginx, Railway). Súbelo si hay más capas (ej. Cloudflare + Nginx = 2).
# TRUSTED_PROXY_HOPS="1"

# Almacenamiento de imágenes:
# - Sin configurar: disco local en MEDIA_DIR (servido en /media/...). Solo para servidores con disco persistente.
# - Con Supabase: bucket PÚBLICO de Supabase Storage (obligatorio en Vercel/serverless).
# STORAGE_DRIVER="supabase"
# SUPABASE_URL="https://xxxx.supabase.co"
# NEXT_PUBLIC_SUPABASE_URL="https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="(clave service_role, solo en el servidor)"
# SUPABASE_STORAGE_BUCKET="marchante-media"
# MEDIA_DIR=".data/media"

# Teselas del mapa del perfil. tile.openstreetmap.org no admite uso comercial intensivo:
# en producción usa un proveedor (MapTiler, Stadia, Thunderforest...) con su llave.
# NEXT_PUBLIC_MAP_TILE_URL="https://api.maptiler.com/maps/streets/256/{z}/{x}/{y}.png?key=TU_LLAVE"
# NEXT_PUBLIC_MAP_TILE_ATTRIBUTION="© MapTiler © OpenStreetMap contributors"
